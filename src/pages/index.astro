---
import Carousel from "../components/carousel.astro";
import ThreeItemGrid from "../components/grid/three-items.astro";
import Footer from "../components/layout/footer.astro";
import RootLayout from "../components/layout/layout.astro";
import LanguageSelector from "../components/language-selector.astro";



import { sortedProductsQuery } from "../lib/wix";
import { multilingual} from '@wix/site';


const allLanguages = multilingual.getAvailableLanguages();
console.log('Available languages - SSR', {allLanguages});

console.log("calling products.queryProducts - SSR");
sortedProductsQuery().then(
    q => q.find()
     .then(({ items }) => {
      const productNames = items.map(item => item.name).join(', ');
       console.log('SSR products:\n\t', productNames);
     })
  );



